<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="rule_mrp_production_staf_only" model="ir.rule">
            <field name="name">Staf hanya melihat SPK yang diarahkan kepadanya</field>
            <field name="model_id" ref="mrp.model_mrp_production"/>
            <field name="domain_force">[('staf_produksi_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('mrp.group_mrp_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>