<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="view_mrp_production_form_inherit_sukha" model="ir.ui.view">
            <field name="name">mrp.production.form.inherit.sukha</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">
                
                <xpath expr="//field[@name='user_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//field[@name='date_finished']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="nama_kepala_produksi" />
                    <field name="staf_produksi_id" />
                </xpath>

                <xpath expr="//notebook" position="inside">
                    <page string="Instruksi &amp; Catatan Sukha Delights">
                        <group>
                            <field name="catatan_produksi" placeholder="Masukkan instruksi khusus resep di sini..."/>
                        </group>
                    </page>
                </xpath>

            </field>
        </record>
    </data>
</odoo>