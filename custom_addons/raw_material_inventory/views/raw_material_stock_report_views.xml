<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_raw_material_stock_report_tree" model="ir.ui.view">
        <field name="name">raw.material.stock.report.tree</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <tree string="Laporan Stok Bahan Baku" decoration-danger="is_stock_critical">
                <field name="default_code"/>
                <field name="name"/>
                <field name="qty_available"/>
                <field name="uom_id"/>
                <field name="raw_material_reorder_point"/>
                <field name="raw_material_stock_status"/>
                <field name="is_stock_critical" invisible="1"/>
                <field name="virtual_available"/>
            </tree>
        </field>
    </record>

    <record id="view_raw_material_stock_report_wizard_form" model="ir.ui.view">
        <field name="name">raw.material.stock.report.wizard.form</field>
        <field name="model">raw.material.stock.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Laporan Stok Bahan Baku">
                <sheet>
                    <group>
                        <field name="report_scope" widget="radio"/>
                        <field
                            name="product_ids"
                            widget="many2many_tags"
                            placeholder="Contoh: pilih BB-001 Tepung Terigu"
                            invisible="report_scope != 'specific'"
                        />
                        <div class="text-muted" invisible="report_scope != 'specific'">
                            Pilih satu atau beberapa bahan baku jika parameter laporan adalah Bahan Tertentu.
                        </div>
                    </group>
                </sheet>
                <footer>
                    <button string="Tampilkan Laporan" type="object" name="action_view_report" class="btn-primary"/>
                    <button string="Batal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_raw_material_stock_report_wizard" model="ir.actions.act_window">
        <field name="name">Laporan Stok Bahan Baku</field>
        <field name="res_model">raw.material.stock.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_raw_material_stock_report_wizard_form"/>
    </record>
</odoo>
