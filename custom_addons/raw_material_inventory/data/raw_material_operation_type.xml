<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_raw_material_usage" model="ir.sequence">
        <field name="name">Raw Material Usage</field>
        <field name="code">raw.material.usage</field>
        <field name="prefix">RMU/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_raw_material_usage_document" model="ir.sequence">
        <field name="name">Raw Material Usage Document</field>
        <field name="code">raw.material.usage.document</field>
        <field name="prefix">RMUD/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_raw_material_receipt_document" model="ir.sequence">
        <field name="name">Raw Material Receipt Document</field>
        <field name="code">raw.material.receipt.document</field>
        <field name="prefix">RMR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="stock_location_raw_material_production" model="stock.location">
        <field name="name">Raw Material Production</field>
        <field name="usage">production</field>
    </record>

    <record id="picking_type_raw_material_usage" model="stock.picking.type">
        <field name="name">Raw Material Usage</field>
        <field name="code">internal</field>
        <field name="sequence_code">RMU</field>
        <field name="sequence_id" ref="seq_raw_material_usage"/>
        <field name="default_location_src_id" ref="stock.stock_location_stock"/>
        <field name="default_location_dest_id" ref="stock_location_raw_material_production"/>
        <field name="show_operations" eval="True"/>
    </record>
</odoo>
