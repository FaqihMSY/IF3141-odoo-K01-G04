<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_fr06_auto_invoice" model="ir.ui.view">
        <field name="name">sale.order.form.fr06.auto.invoice</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_fr06_create_auto_invoice"
                    type="object"
                    string="Create FR-06 Invoice"
                    class="btn-primary"
                    invisible="invoice_status != 'to invoice' or state not in ('sale', 'done')"
                />
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="fr06_auto_invoice_created" readonly="1"/>
                <field name="fr06_auto_invoice_date" readonly="1"/>
                <field name="fr06_auto_invoice_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
